# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template: it holds no secrets, just documents what each
# variable does, and needs to actually be in the repo for that documentation
# to reach anyone else who clones it.
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/

# generated at build time by scripts/generate-static-files.mjs — depends on
# NEXT_PUBLIC_SITE_URL and the ads env vars, so a stale copy from a different
# environment should never end up committed. See app/lib/static-files.ts.
/public/robots.txt
/public/sitemap.xml
/public/ads.txt
