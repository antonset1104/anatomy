# Copy to `.env.local` and fill in. Every value here is optional: with none of
# them set the site runs fine, serves no ads, and has no /ads.txt.
#
# The site is a static export (see the README's "Hosting" section) — these are
# read once, at build time, and baked into the exported HTML and the generated
# robots.txt/sitemap.xml/ads.txt. Changing a value here means running
# `npm run build` (or `npm run seo:generate` for just the three SEO files)
# again and redeploying; it is not something a running server picks up live.
#
# Note that `.env*` is gitignored, so this example file is the only copy in the
# repository — keep it in sync when you add a variable.

# ----------------------------------------------------------------------- SEO

# The canonical origin, with no trailing slash. Everything absolute — canonicals,
# hreflang, og:image, the sitemap — is built from this, so getting it wrong is the
# one setting that can quietly de-index the site.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Every build is indexable by default — set this to "false" on the one build
# that should NOT be, such as a staging deployment or a PR preview. There is
# deliberately no platform-specific auto-detection (e.g. a Vercel env check):
# on a single-environment Cloudflare deploy that only ever produces a false
# sense of safety, since the variable it would check is never set there.
# NEXT_PUBLIC_ALLOW_INDEXING=false

# ---------------------------------------------------------------- monetisation

# AdSense publisher id. Until this is set no ad markup is rendered, no
# third-party script is loaded, and /ads.txt returns 404.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# Ad unit ids, created in the AdSense dashboard. A slot with no id renders
# nothing, so you can switch on one placement at a time.
#   ARTICLE — mid-content on organ and system pages
#   LISTING — above the fold on the systems, glossary, and lessons hubs
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_LISTING=0000000000

# Extra ads.txt records, comma or newline separated, for a second seller such as
# an ad manager or a mediation partner. The Google DIRECT line is generated from
# NEXT_PUBLIC_ADSENSE_CLIENT and does not need repeating here.
# ADS_TXT_EXTRA_RECORDS=example-exchange.com, 12345, RESELLER, 0bfd66d529a55807
